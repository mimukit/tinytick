  },
  "devDependencies": {
    "@raycast/api": "^2.6.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
