{
  "name": "tinytick",
  "version": "0.1.0",
  "private": true,
  "description": "A TickTick extension for the Tinycast launcher.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
